# ---- Model access -------------------------------------------------------
# "anthropic" (default, used in production) calls the Messages API with ANTHROPIC_API_KEY.
# "claude-cli" sends the same requests to the local shim (make shim), which runs `claude -p`
# with your existing Claude Code login. Local testing only.
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max  (Haiku 5.5 defaults to medium)
LLM_EFFORT=medium
CLAUDE_CLI_SHIM_URL=http://127.0.0.1:8788

# ---- Storage ------------------------------------------------------------
# Leave MONGODB_URI empty to use a JSON file at data/undercurrent.json.
# Production needs MongoDB (Vercel's filesystem is ephemeral).
MONGODB_URI=
MONGODB_DB=undercurrent

# ---- Access -------------------------------------------------------------
# If set, every API call must send this code (the UI prompts for it once).
# Strongly recommended on a public deployment so strangers can't spend your API credits.
ACCESS_CODE=
# 1 = public read-only demo: visitors without the code can browse the saved demo runs and validation
# results. Anything that writes or calls the model still needs ACCESS_CODE (with no code set, nobody can).
PUBLIC_DEMO=

# ---- Simulations ----------------------------------------------------------
# Agents use LLM_MODEL unless SIM_MODEL pins another (Haiku keeps big panels cheap).
SIM_MODEL=
# Parallel model calls per step (default 12; 3 with the CLI shim).
SIM_CONCURRENCY=
# Hard cap on model calls in one run.
SIM_MAX_CALLS_PER_RUN=5000
SIM_MAX_AGENTS=500
SIM_MAX_SOCIAL_AGENTS=200
# Agent calls run at low effort with thinking off; their answers include a short reasoning field instead.
SIM_AGENT_EFFORT=low
SIM_AGENT_THINKING=off
